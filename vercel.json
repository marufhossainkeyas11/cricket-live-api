{
  "rewrites": [
    { "source": "/match/:id", "destination": "/viewer.html" },
    { "source": "/",          "destination": "/viewer.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
